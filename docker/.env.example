############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
TEMPLATE_DATABASE_NAME=supabase_template

# Service Users Configuration
JWT_SECRET=your-jwt-secret-change-this
SUPABASE_JWT_SECRET=your-jwt-secret-change-this
ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key
SECRET_KEY_BASE=your-secret-key-base-change-this-in-production
VAULT_ENC_KEY=your-encryption-key-32-chars-min
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# Frontend environment variables for browser access
NEXT_PUBLIC_GOTRUE_URL=http://localhost:8000/auth/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# API Proxy
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# Auth
############

SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
GOTRUE_JWT_ISSUER=http://localhost:8000
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION="Default Organization"
STUDIO_DEFAULT_PROJECT="Default Project"
ENABLE_USER_ISOLATION=true

############
# Runtime Configuration
############

SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
ENVIRONMENT=development
NODE_ENV=development
NEXT_PUBLIC_IS_PLATFORM=false
NEXT_PUBLIC_REQUIRE_LOGIN=true
ENABLE_SUPABASE_DB=true

############
# Functions
############

FUNCTIONS_VERIFY_JWT=false

############
# Edge Functions Storage Backend Configuration
############

EDGE_FUNCTIONS_STORAGE_BACKEND=local
# EDGE_FUNCTIONS_STORAGE_BACKEND=s3

# Local Storage Configuration (when backend is 'local')
EDGE_FUNCTIONS_LOCAL_PATH=/home/deno/functions

# S3 Storage Configuration (when backend is 's3')
# EDGE_FUNCTIONS_S3_BUCKET_NAME=my-edge-functions-bucket
# EDGE_FUNCTIONS_S3_REGION=us-east-1
# EDGE_FUNCTIONS_S3_ENDPOINT=https://s3.amazonaws.com

# AWS Credentials (reused from existing storage configuration)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

############
# Deno Runtime Configuration
############

DENO_PATH=deno
EDGE_FUNCTIONS_TEMP_DIR=/tmp/edge-functions
EDGE_FUNCTIONS_CACHE_DIR=/tmp/deno-cache
EDGE_FUNCTIONS_EXECUTION_TIMEOUT=30000
EDGE_FUNCTIONS_TYPE_CHECK=true

# Deno Permissions Configuration
DENO_ALLOW_NET=true
DENO_ALLOW_READ=/tmp/edge-functions,/home/deno/functions
DENO_ALLOW_WRITE=false
DENO_ALLOW_ENV=SUPABASE_URL,SUPABASE_ANON_KEY
DENO_ALLOW_RUN=false

############
# Edge Functions Service Configuration
############

EDGE_FUNCTIONS_URL=http://functions:9000
EDGE_FUNCTIONS_PORT=9000

############
# CORS Configuration for Edge Functions
############

# CORS allowed origins (comma-separated list)
# Default includes common Studio development origins
EDGE_FUNCTIONS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# CORS allowed headers (comma-separated list)
# Includes user-agent to fix specific CORS blocking issues
EDGE_FUNCTIONS_CORS_ALLOWED_HEADERS=user-agent,content-type,authorization,x-client-info,apikey,x-supabase-api-version,cache-control,pragma,accept,accept-language,accept-encoding,x-requested-with

# CORS allowed methods (comma-separated list)
EDGE_FUNCTIONS_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS allow credentials (true/false)
EDGE_FUNCTIONS_CORS_ALLOW_CREDENTIALS=true

# CORS max age for preflight cache (seconds)
EDGE_FUNCTIONS_CORS_MAX_AGE=86400
